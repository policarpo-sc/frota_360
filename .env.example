# Google Drive service account (JSON key contents, base64-encoded)
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
# Google Drive folder ID containing the 3 project spreadsheets
GOOGLE_DRIVE_FOLDER_ID=
# Redis connection string (from the Vercel Storage / Redis database's
# "Quickstart" tab, or auto-populated if the integration provides it)
REDIS_URL=
# Secret used to sign session JWTs (openssl rand -base64 32)
SESSION_SECRET=
# Seed admin account, created automatically on first login attempt if it doesn't exist yet
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
